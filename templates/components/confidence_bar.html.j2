{% macro confidence_bar(value, label="Confidence") %}
<div class="confidence-bar" data-value="{{ value | round(3) }}"
     style="--fill: {{ (value * 100) | round }}%">
  <label>{{ label }}: {{ (value * 100) | round }}%</label>
  <div class="bar-track">
    <div class="bar-fill"></div>
  </div>
  <meter value="{{ value }}" min="0" max="1"></meter>
</div>
{% endmacro %}
